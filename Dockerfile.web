# Build React App
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# Setup Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /var/www/html/dist
COPY backend /var/www/html/backend
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
